    {
      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "lede": "These are standards published by the carrier for delays and cancellations. On codeshares or interline itineraries, the operating carrier is responsible.",
      "required": [
        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Under UK/EU 261, delayed or cancelled flights trigger meals, refreshments, 2 phone calls/emails, and hotel accommodation with transport for overnight delays.",
          "status": "official",
          "source_url": "https://www.britishairways.com/en-gb/information/legal/flight-cancellations-and-delays",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Full refund or rebooking on alternative transport for cancellations or delays exceeding 5 hours.",
          "status": "official",
          "source_url": "https://www.britishairways.com/en-gb/information/legal/flight-cancellations-and-delays",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "UK261 statutory compensation (£220 to £520) for cancellations or delays over 3 hours within carrier control.",
          "status": "official",
          "source_url": "https://www.britishairways.com/en-gb/information/legal/flight-cancellations-and-delays",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        }
      }
    },
