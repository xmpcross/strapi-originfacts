    {
      "id": "checkin",
      "title": "Check-in and airport cutoffs",
      "required": [
        "online_checkin",
        "counter_open",
        "checkin_close"
      ],
      "fields": {
        "online_checkin": {
          "value": "Online check-in is available from 24 hours up until 3 hours before scheduled departure; it is not available on Air Niugini flights originating from Australia and Japan. After checking in online, report 90 minutes before departure with baggage, or 60 minutes without, for document checks.",
          "status": "official",
          "source_url": "https://www.airniugini.com.pg/conditions-of-carriage/",
          "verified_at": "2026-09-03",
          "verified_by": "manual_official_source"
        },
        "counter_open": {
          "value": "Check-in counters open 2 hours before departure for domestic flights and 3 hours before for international flights.",
          "status": "official",
          "source_url": "https://www.airniugini.com.pg/conditions-of-carriage/",
          "verified_at": "2026-09-03",
          "verified_by": "manual_official_source"
        },
        "checkin_close": {
          "value": "Check-in closes 45 minutes before departure; boarding time is 30 minutes before departure.",
          "status": "official",
          "source_url": "https://www.airniugini.com.pg/conditions-of-carriage/",
          "verified_at": "2026-09-03",
          "verified_by": "manual_official_source"
        },
        "fail_to_board": {
          "value": "A passenger who has checked in (online or at the counter) and then fails to board has the ticket forfeited; this applies to Economy and Business class tickets.",
          "status": "official",
          "source_url": "https://www.airniugini.com.pg/conditions-of-carriage/",
          "verified_at": "2026-09-03",
          "verified_by": "manual_official_source"
