          "source_url": "https://www.bahamasair.com/baggage",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "fees_international": {
          "value": "International flights (including Cuba): first bag $35.00; second bag $55.00; third bag $95.00; fourth and further bags $125.00.",
          "status": "official",
          "source_url": "https://www.bahamasair.com/baggage",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "overweight": {
          "value": "Bags over 50lbs (23kgs) up to 70lbs (32kgs) cost the piece price + $50 (+ VAT on domestic flights). Internationally, bags over 62” cost piece price + $150.00, or + $175.00 if also over 50lbs. Bags over 70lbs (32kgs) are not accepted.",
          "status": "official",
          "source_url": "https://www.bahamasair.com/baggage",
