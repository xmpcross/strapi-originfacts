    {
      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "lede": "These are standards published by the carrier for delays and cancellations. On codeshares or interline itineraries, the operating carrier is responsible.",
      "required": [
        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Meals, drinks, 2 communications, and hotel accommodation with transport for overnight delays under EU 261 / Swiss law.",
          "status": "official",
          "source_url": "https://www.swiss.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Full ticket refund within 7 days or rebooking to final destination for delays >5 hours or cancellations.",
          "status": "official",
          "source_url": "https://www.swiss.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "Statutory compensation (€250 to €600) under EU 261 / Swiss regulations for cancellations or delays >3 hours.",
          "status": "official",
          "source_url": "https://www.swiss.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        }
      }
    },
