      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "lede": "These are standards published by the carrier for delays and cancellations. On codeshares or interline itineraries, the operating carrier is responsible.",
      "required": [
        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Meals, refreshments, phone/internet access, and hotel accommodation with transport for overnight delays.",
          "status": "official",
          "source_url": "https://www.rj.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Choice of full refund or rebooking to final destination without fee if delayed >4 hours or cancelled.",
          "status": "official",
          "source_url": "https://www.rj.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "Compensation provided per Jordan Civil Aviation Regulatory Commission rules or international conventions.",
          "status": "official",
          "source_url": "https://www.rj.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
