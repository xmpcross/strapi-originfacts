      "id": "carryon",
      "title": "Carry-on",
      "lede": "Economy passengers may bring one piece of carry-on baggage; Crown Class passengers two, except on Embraers where only one is allowed.",
      "required": [
        "carryon_bag_dimensions",
        "carryon_weight",
        "personal_item"
      ],
      "fields": {
        "carryon_bag_dimensions": {
          "value": "Up to 23X41X51cm (9X16X20in), with the three dimensions adding up to no more than 115 cm (45 inches), wheels, handles and side pockets included.",
          "status": "official",
          "source_url": "https://www.rj.com/en/info-and-tips/baggage-information/carry-on-pieces",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "carryon_weight": {
          "value": "Each piece must not exceed 7 kg. Economy: 1 piece. Crown Class: 2 pieces (7 kg each), or 1 piece on Embraer aircraft.",
          "status": "official",
          "source_url": "https://www.rj.com/en/info-and-tips/baggage-information/carry-on-pieces",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "personal_item": {
          "value": "1 personal item of maximum 20x40x35cm and 5 kg, placed under the seat in front.",
          "status": "official",
          "source_url": "https://www.rj.com/en/info-and-tips/baggage-information/carry-on-pieces",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "infants": {
          "value": "Passengers with infants may bring baby food and other necessities up to 7 kgs/15 lbs in addition to the adult's carry-on allowance.",
          "status": "official",
          "source_url": "https://www.rj.com/en/info-and-tips/baggage-information/carry-on-pieces",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        }
      }
    },
