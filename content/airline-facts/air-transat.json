    {
      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "lede": "These are standards published by the carrier for delays and cancellations. On codeshares or interline itineraries, the operating carrier is responsible.",
      "required": [
        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Food, beverages, communication, and hotel lodging for overnight delays under Canadian APPR & EU 261.",
          "status": "official",
          "source_url": "https://www.airtransat.com/en-CA/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Full refund or rebooking to destination if flight cancelled or delayed >3 hours.",
          "status": "official",
          "source_url": "https://www.airtransat.com/en-CA/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "APPR statutory compensation (up to CAD $1,000) / EU 261 (€250–€600) for controllable delays >3h.",
          "status": "official",
          "source_url": "https://www.airtransat.com/en-CA/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        }
      }
    },
