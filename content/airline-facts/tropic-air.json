    {
      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "required": [
        "rebooking_refund",
        "care"
      ],
      "fields": {
        "rebooking_refund": {
          "value": "For delays or cancellations caused by disruptions within Tropic Air's control, it offers rebooking at no additional cost; if no suitable option exists and you no longer need to travel, you may be eligible for a refund of the unused portion of the ticket.",
          "status": "official",
          "source_url": "https://www.tropicair.com/travel-info/conditions-of-carriage/",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "care": {
          "value": "For overnight delays caused by Tropic Air's direct operational fault when you are away from your home city, it may arrange or cover basic hotel accommodation, subject to availability and prior approval. For causes beyond its control (weather, air traffic restrictions, force majeure) it helps with rebooking but does not pay for hotels, meals or alternative transport.",
          "status": "official",
          "source_url": "https://www.tropicair.com/travel-info/conditions-of-carriage/",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        }
      }
    },
    {
