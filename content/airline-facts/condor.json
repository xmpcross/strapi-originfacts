        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Meals, refreshments, communication access, and hotel accommodation with transport for overnight delays under EU 261.",
          "status": "official",
          "source_url": "https://www.condor.com/en-gb/information-services/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Full refund or free rebooking to final destination for delays >5 hours or flight cancellations.",
          "status": "official",
          "source_url": "https://www.condor.com/en-gb/information-services/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "EU 261 statutory compensation (€250 to €600) for airline-caused delays >3 hours or cancellations.",
