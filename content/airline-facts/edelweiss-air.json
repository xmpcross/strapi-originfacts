        "carryon_bag_dimensions",
        "carryon_weight",
        "personal_item"
      ],
      "fields": {
        "carryon_bag_dimensions": {
          "value": "Economy Class: 1 item; Business Class: 2 items. Each up to 55 x 40 x 23 cm.",
          "status": "official",
          "source_url": "https://www.flyedelweiss.com/gb/en/prepare/baggage/free-baggage/hand-baggage.html",
          "verified_at": "2026-09-03",
          "verified_by": "manual_official_source"
        },
        "carryon_weight": {
          "value": "8 kg per baggage item, in both Economy and Business Class.",
          "status": "official",
          "source_url": "https://www.flyedelweiss.com/gb/en/prepare/baggage/free-baggage/hand-baggage.html",
          "verified_at": "2026-09-03",
          "verified_by": "manual_official_source"
        },
        "personal_item": {
          "value": "One personal item at no extra charge, such as a handbag, laptop bag or shoulder bag (maximum 40 x 30 x 15 cm).",
          "status": "official",
          "source_url": "https://www.flyedelweiss.com/gb/en/prepare/baggage/free-baggage/hand-baggage.html",
          "verified_at": "2026-09-03",
          "verified_by": "manual_official_source"
        },
        "infants": {
          "value": "Hand baggage for children under two (2) years of age must be stored within the adults' permitted hand baggage.",
          "status": "official",
          "source_url": "https://www.flyedelweiss.com/gb/en/prepare/baggage/free-baggage/hand-baggage.html",
          "verified_at": "2026-09-03",
          "verified_by": "manual_official_source"
        }
      }
    },
    {
      "id": "baggage",
      "title": "Checked baggage",
      "lede": "The free checked allowance depends on destination and travel class.",
      "required": [
        "allowance_by_cabin",
        "size_weight"
      ],
      "fields": {
        "allowance_by_cabin": {
          "value": "Business Class: 2 x 32 kg. Economy Class / Economy Max: 1 x 23 kg. Children 2-12 get the same as adults plus a car seat, pram or buggy; infants 0-2 get 1 x 23 kg plus a car seat, pram or buggy.",
          "status": "official",
          "source_url": "https://www.flyedelweiss.com/ch/de/prepare/baggage/free-baggage/checked-baggage.html",
          "verified_at": "2026-09-03",
          "verified_by": "manual_official_source"
        },
        "size_weight": {
          "value": "Every bag may measure up to 158 cm (height + length + width). Bags heavier than 32 kg are not accepted at the counter and must be sent separately as cargo.",
          "status": "official",
          "source_url": "https://www.flyedelweiss.com/ch/de/prepare/baggage/free-baggage/checked-baggage.html",
          "verified_at": "2026-09-03",
          "verified_by": "manual_official_source"
        }
      }
    },
