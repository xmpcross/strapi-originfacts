          "source_url": "https://www.cathaypacific.com/cx/en_HK/legal-and-privacy/customer-service-commitments.html",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Rebooking on next available flight or full refund to original payment method if flight is cancelled or delayed 3+ hours.",
