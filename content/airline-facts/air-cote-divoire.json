    {
      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "lede": "Air Côte d'Ivoire's conditions of carriage set out what it offers when it cancels or seriously delays a flight.",
      "required": [
        "rebooking",
        "refund"
      ],
      "fields": {
        "rebooking": {
          "value": "If Air Côte d'Ivoire cancels a flight, operates it excessively late, skips your stop or makes you miss a connection on the same contract of carriage, it will, in agreement with you, carry you on another flight with a seat available at no extra cost, or reroute you on its own or another carrier's flights or by surface transport.",
          "status": "official",
          "source_url": "https://www.aircotedivoire.com/en/flight-booking/terms-and-conditions-of-carriage",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "refund": {
          "value": "If you accept neither option, the ticket is refunded: the full fare paid if no part was used, or the difference between the fare paid and the fare for the unflown part if partly used.",
          "status": "official",
          "source_url": "https://www.aircotedivoire.com/en/flight-booking/terms-and-conditions-of-carriage",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "denied_boarding": {
          "value": "If you are denied boarding because of overbooking after checking in on time, you are compensated in accordance with the applicable regulations.",
          "status": "official",
          "source_url": "https://www.aircotedivoire.com/en/flight-booking/terms-and-conditions-of-carriage",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        }
      }
