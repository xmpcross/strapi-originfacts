    {
      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "lede": "These are standards published by the carrier for delays and cancellations. On codeshares or interline itineraries, the operating carrier is responsible.",
      "required": [
        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Under EU Regulation 261/2004, delayed or cancelled flights entitle passengers to meals, refreshments, two free phone calls/emails, and hotel accommodation for overnight delays.",
          "status": "official",
          "source_url": "https://www.lufthansa.com/de/en/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "For cancellations or delays exceeding 5 hours, Lufthansa provides a full refund or rebooking on alternative transport to the destination under comparable conditions.",
          "status": "official",
          "source_url": "https://www.lufthansa.com/de/en/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "EU Regulation 261/2004 statutory compensation (€250 to €600) applies for cancellations or delays over 3 hours at arrival within airline control.",
          "status": "official",
          "source_url": "https://www.lufthansa.com/de/en/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        }
      }
    },
    {
