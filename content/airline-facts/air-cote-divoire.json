          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "personal_item": {
          "value": "One accessory (a handbag, laptop bag, camera bag or other electronic device bag) no larger than 40 cm long, 30 cm deep and 15 cm wide.",
