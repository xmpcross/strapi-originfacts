          "source_url": "https://www.airtransat.com/en-GB/legal-notice-uk/general-terms-and-conditions",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "seat_selection_hold": {
          "value": "An advance seat selection is held until 75 minutes before departure; after that it can be cancelled without refund.",
          "status": "official",
          "source_url": "https://www.airtransat.com/en-GB/legal-notice-uk/general-terms-and-conditions",
          "verified_at": "2026-09-04",
