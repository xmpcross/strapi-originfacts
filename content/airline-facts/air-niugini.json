        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Meals, beverages, communication services, and hotel accommodation for overnight delays under CASA PNG rules.",
          "status": "official",
          "source_url": "https://www.airniugini.com.pg/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Rebooking on next available Air Niugini flight or full refund for delays >4 hours or cancellations.",
          "status": "official",
          "source_url": "https://www.airniugini.com.pg/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
