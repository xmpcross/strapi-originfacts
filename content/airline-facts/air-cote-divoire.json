      "title": "Checked baggage",
      "lede": "The checked allowance depends on your travel class and the network you fly.",
      "required": [
        "allowance_domestic",
        "allowance_regional",
        "allowance_international"
      ],
      "fields": {
        "allowance_domestic": {
          "value": "Domestic network: one bag in Economy (max 23 kg per bag); one bag in Business (max 30 kg per bag).",
          "status": "official",
          "source_url": "https://www.aircotedivoire.com/informations/bagages",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "allowance_regional": {
          "value": "Regional network: 40 kg in Economy and 50 kg in Business, with a maximum of 32 kg per bag.",
          "status": "official",
          "source_url": "https://www.aircotedivoire.com/informations/bagages",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "allowance_international": {
          "value": "Johannesburg, Casablanca and future international destinations: 2 bags in Economy and Premium Economy (max 23 kg each), 2 bags in Business (max 32 kg each), 3 bags in First (max 32 kg).",
          "status": "official",
          "source_url": "https://www.aircotedivoire.com/informations/bagages",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
