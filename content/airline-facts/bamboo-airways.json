      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "lede": "These are standards published by the carrier for delays and cancellations. On codeshares or interline itineraries, the operating carrier is responsible.",
      "required": [
        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Meals, beverages, communication services, and hotel lodging for overnight delays under CAAV rules.",
          "status": "official",
          "source_url": "https://www.bambooairways.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Full refund or free change of schedule if flight is cancelled or delayed >4 hours.",
          "status": "official",
          "source_url": "https://www.bambooairways.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "Statutory non-refundable compensation mandated by Ministry of Transport of Vietnam.",
          "status": "official",
          "source_url": "https://www.bambooairways.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
