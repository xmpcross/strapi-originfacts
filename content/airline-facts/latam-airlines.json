    {
      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "lede": "These are standards published by the carrier for delays and cancellations. On codeshares or interline itineraries, the operating carrier is responsible.",
      "required": [
        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Meals, beverages, phone calls, and hotel accommodation with transport for delays over 4 hours overnight under South American ANAC/JAC guidelines.",
          "status": "official",
          "source_url": "https://www.latamairlines.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Full ticket refund or change of date/flight without penalty for cancellations or delays exceeding 4 hours.",
          "status": "official",
          "source_url": "https://www.latamairlines.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "Financial compensation or travel voucher assistance provided according to governing country regulations (e.g. ANAC Res 400 in Brazil).",
          "status": "official",
          "source_url": "https://www.latamairlines.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        }
