{
  "compilerOptions": {
    "target": "ES2023",
    // "dom" is required for the page.evaluate() callbacks, which run in the
    // browser and reference `document`. Nothing in Node relies on it.
    "lib": ["ES2023", "dom"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts"]
}
