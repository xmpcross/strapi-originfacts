          "source_url": "https://www.klm.com/information/legal/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "EU261 statutory compensation (€250 to €600) for flight delays of 3+ hours or cancellations within airline control.",
