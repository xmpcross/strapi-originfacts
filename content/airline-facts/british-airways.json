    {
      "id": "cabins",
      "title": "Cabins and seating",
      "lede": "Choose a seat by location and legroom, or accept a free seat assignment at check-in. Use your flight seat map because options vary with the aircraft.",
      "required": [
        "seat_options",
        "reserved_or_random",
        "family_seating"
      ],
      "fields": {
        "seat_options": {
          "value": "First Class (1-2-1 suites with privacy door), Club Suite / Club World (1-2-1 lie-flat suites with door), World Traveller Plus (2-4-2 38\" pitch), and World Traveller Economy (3-3-3 / 3-4-3 31\" pitch)",
          "status": "official",
          "source_url": "https://www.britishairways.com/en-gb/information/about-ba/fleet-facts",
