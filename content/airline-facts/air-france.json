    {
      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "lede": "These are standards published by the carrier for delays and cancellations. On codeshares or interline itineraries, the operating carrier is responsible.",
      "required": [
        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Complimentary meals, refreshments, two telephone calls/emails, and hotel accommodation with transport for overnight delays under EU 261/2004.",
          "status": "official",
          "source_url": "https://www.airfrance.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Full refund within 7 days or rebooking to final destination at earliest opportunity if delayed >5 hours or flight cancelled.",
          "status": "official",
          "source_url": "https://www.airfrance.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "EU 261 statutory compensation (€250 for ≤1500km, €400 for 1500–3500km, €600 for >3500km) for cancellations or 3+ hour arrival delays unless caused by extraordinary circumstances.",
          "status": "official",
          "source_url": "https://www.airfrance.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        }
      }
    },
