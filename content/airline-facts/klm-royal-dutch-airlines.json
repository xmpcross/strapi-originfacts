          "source_url": "https://www.klm.com/information/legal/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Full refund or rebooking on next available flight for cancellations or delays exceeding 5 hours.",
