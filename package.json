{
  "name": "fxn-travel-blog",
  "version": "1.0.0",
  "private": true,
  "description": "FXN Studio travel blog — Next.js frontend for Strapi CMS",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "tsx --test tests/*.test.ts",
    "validate:facts": "node ops/validate-airline-facts.mjs",
    "validate:facts:fixtures": "node ops/validate-airline-facts.mjs --fixtures",
    "audit:top-airports": "node ops/audit-top-airport-uniqueness.mjs",
    "discover:top-airport-sources": "node ops/discover-top-airport-sources.mjs",
    "enrich:top-airports": "node ops/enrich-top-airport-content-sonnet.mjs",
    "sync:facts": "node ops/sync-airline-facts.mjs",
    "prebuild": "node ops/validate-airline-facts.mjs",
    "fetch": "yarn --cwd ops/fetch fetch",
    "reach": "yarn --cwd ops/fetch reach",
    "ingest-manual": "yarn --cwd ops/fetch ingest-manual",
    "extract": "yarn --cwd ops/fetch extract",
    "preflight": "yarn --cwd ops/fetch preflight",
    "draft": "yarn --cwd ops/fetch draft",
    "promote": "yarn --cwd ops/fetch promote"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.52.0",
    "marked": "^15.0.3",
    "next": "^15.5.21",
    "nodemailer": "^10.0.0",
    "qs": "^6.15.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "resolutions": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0",
    "qs": "^6.15.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qs": "^6.9.17",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.17",
    "tldts": "^7.4.10",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
