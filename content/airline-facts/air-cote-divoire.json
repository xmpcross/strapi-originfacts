          "value": "An infant under 2 gets a 10 kg allowance, plus a folding pushchair, carrycot or infant car seat.",
          "status": "official",
          "source_url": "https://www.aircotedivoire.com/informations/bagages",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "excess_baggage": {
          "value": "Extra baggage can be bought from 24 hours before departure until check-in; the price depends on the destination.",
