          "value": "Domestic flights within Belize: check in at least 30 minutes before departure.",
          "status": "official",
          "source_url": "https://www.tropicair.com/travel-info/conditions-of-carriage/",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "international_cutoff": {
          "value": "International flights: Tropic Air recommends checking in no later than 2 hours before departure.",
          "status": "official",
          "source_url": "https://www.tropicair.com/travel-info/conditions-of-carriage/",
          "verified_at": "2026-09-04",
