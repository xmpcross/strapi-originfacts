    {
      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "lede": "These are standards published by the carrier for delays and cancellations. On codeshares or interline itineraries, the operating carrier is responsible.",
      "required": [
        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Meals, refreshments, communication, and hotel lodging for overnight delays under EU 261 / Irish CAR rules.",
          "status": "official",
          "source_url": "https://www.aerlingus.com/support/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Full refund or rebooking to final destination for flight cancellations or delays >5 hours.",
          "status": "official",
          "source_url": "https://www.aerlingus.com/support/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "EU 261 statutory compensation (€250 to €600) for airline-caused delays >3 hours or cancellations.",
          "status": "official",
          "source_url": "https://www.aerlingus.com/support/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        }
