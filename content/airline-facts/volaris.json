      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "lede": "These are standards published by the carrier for delays and cancellations. On codeshares or interline itineraries, the operating carrier is responsible.",
      "required": [
        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Food, drinks, phone/email access, and hotel accommodation for delays >4 hours attributable to airline under AFAC rules.",
          "status": "official",
          "source_url": "https://www.volaris.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Choice of full refund or rebooking to destination free of charge if cancelled or delayed >4 hours.",
          "status": "official",
          "source_url": "https://www.volaris.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "Statutory compensation (up to 25% of ticket price) for airline-caused cancellations/delays under AFAC rules.",
          "status": "official",
          "source_url": "https://www.volaris.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
