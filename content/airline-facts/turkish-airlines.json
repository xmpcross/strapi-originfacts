        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Free meals, drinks, communication access, and hotel accommodation with transfers for overnight delays per Turkish SHY-PASS and EU 261 rules.",
          "status": "official",
          "source_url": "https://www.turkishairlines.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Full refund or alternative flight routing free of charge if flight is cancelled or delayed >5 hours.",
          "status": "official",
          "source_url": "https://www.turkishairlines.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "Statutory compensation up to €600 (or SHY-PASS equivalent in TRY) for cancellations or delays >3 hours without 14 days notice.",
