    {
      "id": "baggage",
      "title": "Checked baggage",
      "lede": "Vieques Air Link sets one weight allowance that covers checked, carry-on and personal items together.",
      "required": [
        "allowance",
        "excess_fee",
        "dimensions"
      ],
      "fields": {
        "allowance": {
          "value": "All fares include 25 lbs of free baggage, which includes carry-on and personal items. There is no limit on the number of pieces if the total weight does not exceed 50 lbs.",
          "status": "official",
          "source_url": "https://viequesairlink.com/baggage-policy",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "excess_fee": {
          "value": "Weight over the 25 lbs allowance costs $2.00 per pound. Excess baggage that cannot be accommodated travels on a later flight.",
          "status": "official",
          "source_url": "https://viequesairlink.com/baggage-policy",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "dimensions": {
          "value": "Baggage dimensions: maximum 22″ x 15″ x 9″, wheels and handles included.",
          "status": "official",
          "source_url": "https://viequesairlink.com/baggage-policy",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "connections": {
          "value": "Vieques Air Link does not transfer baggage to other airlines; claim your bags and recheck them with your connecting carrier.",
          "status": "official",
          "source_url": "https://viequesairlink.com/baggage-policy",
          "verified_at": "2026-09-04",
