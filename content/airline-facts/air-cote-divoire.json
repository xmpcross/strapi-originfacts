          "value": "Regional network: 1 bag and 1 accessory in both Economy and Business, total weight 10 kg.",
          "status": "official",
          "source_url": "https://www.aircotedivoire.com/informations/bagages",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
