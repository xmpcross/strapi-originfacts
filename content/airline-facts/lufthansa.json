      "fields": {
        "fare_name": {
          "value": "Economy Light: includes 1 carry-on bag up to 8 kg; checked baggage incurs an additional fee",
          "status": "official",
          "source_url": "https://www.lufthansa.com/de/en/economy-light-fare",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "seat_selection_included": {
          "value": "Free seat assignment during online check-in 30 hours before departure; advance seat selection prior to check-in requires a fee",
          "status": "official",
          "source_url": "https://www.lufthansa.com/de/en/economy-light-fare",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "change_cancellation_policy": {
          "value": "Non-rebookable and non-refundable unless permitted by specific fare upgrade or statutory passenger rights",
          "status": "official",
          "source_url": "https://www.lufthansa.com/de/en/economy-light-fare",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        }
      }
    },
