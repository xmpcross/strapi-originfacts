      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "lede": "These are standards published by the carrier for delays and cancellations. On codeshares or interline itineraries, the operating carrier is responsible.",
      "required": [
        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Food, drink, two phone calls/emails, and hotel accommodation with transfers for overnight delays under UK 261 / EU 261.",
          "status": "official",
          "source_url": "https://www.virginatlantic.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Full refund within 7 days or rebooking on next available flight if cancelled or delayed >5 hours.",
          "status": "official",
          "source_url": "https://www.virginatlantic.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "UK 261 statutory compensation (£220 to £520 depending on flight length) for cancellations or delays >3 hours at destination.",
          "status": "official",
          "source_url": "https://www.virginatlantic.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        }
