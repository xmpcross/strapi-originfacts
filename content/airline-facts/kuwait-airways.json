      "id": "carryon",
      "title": "Carry-on",
      "lede": "Kuwait Airways allows one piece of cabin luggage on all routes, with a weight limit set by class.",
      "required": [
        "carryon_bag_dimensions",
        "weight_economy",
        "weight_business_first",
        "personal_item"
      ],
      "fields": {
        "carryon_bag_dimensions": {
          "value": "56 x 46 x 25 cm",
          "status": "official",
          "source_url": "https://www.kuwaitairways.com/baggage/hand-baggage",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "weight_economy": {
          "value": "1 piece up to 7 kg + 1 personal item",
          "status": "official",
          "source_url": "https://www.kuwaitairways.com/baggage/hand-baggage",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "weight_business_first": {
          "value": "1 piece up to 11 kg + 1 personal item (Royal / First / Business)",
          "status": "official",
          "source_url": "https://www.kuwaitairways.com/baggage/hand-baggage",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "personal_item": {
          "value": "In addition, ONE item from: a ladies handbag, a briefcase, a coat, cape or blanket, an umbrella, binoculars or a small camera, crutches or a walking stick, or one duty free item bought on the day of flight.",
          "status": "official",
          "source_url": "https://kuwaitairways.com/en/is/free-carry-on-baggage",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
