      "fields": {
        "allowance": {
          "value": "Each ticketed passenger is allowed 50 pounds of checked baggage on a scheduled flight. Baggage beyond 50 pounds per person is excess baggage: extra fees apply, charged per pound by route, and it may not travel on the same flight as you.",
          "status": "official",
          "source_url": "https://www.flyalaskaseaplanes.com/flight-info/baggage.html",
          "verified_at": "2026-10-05",
          "verified_by": "manual_official_source"
        },
        "heavy_fee": {
          "value": "Single-piece heavy fee: $30 for 51-70 pounds, $40 for 71-100 pounds, $50 for 101-150 pounds. Unboxed bicycles and hazardous material are $50 each.",
          "status": "official",
          "source_url": "https://www.flyalaskaseaplanes.com/flight-info/baggage.html",
          "verified_at": "2026-10-05",
          "verified_by": "manual_official_source"
        },
        "max_piece": {
          "value": "The single-piece maximum weight is 150 pounds; anything heavier needs approval from management.",
          "status": "official",
          "source_url": "https://www.flyalaskaseaplanes.com/flight-info/baggage.html",
          "verified_at": "2026-10-05",
          "verified_by": "manual_official_source"
