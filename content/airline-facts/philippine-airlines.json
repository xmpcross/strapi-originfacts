    {
      "id": "rights",
      "title": "If your flight is delayed or cancelled",
      "lede": "These are standards published by the carrier for delays and cancellations. On codeshares or interline itineraries, the operating carrier is responsible.",
      "required": [
        "care",
        "rebooking_refund",
        "compensation"
      ],
      "fields": {
        "care": {
          "value": "Meals, refreshments, communication, and hotel accommodation for delays under Philippines Air Passenger Bill of Rights (CAB ER No. 2).",
          "status": "official",
          "source_url": "https://www.philippineairlines.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "rebooking_refund": {
          "value": "Full refund or rebooking without penalty if flight cancelled or delayed >3 hours.",
          "status": "official",
          "source_url": "https://www.philippineairlines.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
        },
        "compensation": {
          "value": "Statutory compensation and reimbursement under Joint DOTC-DTI Regulation No. 1.",
          "status": "official",
          "source_url": "https://www.philippineairlines.com/passenger-rights",
          "verified_at": "2026-10-06",
          "verified_by": "manual_official_source"
