      "title": "Carry-on",
      "lede": "A carry-on that does not fit the template is checked in as regular luggage.",
      "required": [
        "carryon_bag_dimensions",
        "carryon_weight",
        "personal_item"
      ],
      "fields": {
        "carryon_bag_dimensions": {
          "value": "One small carry-on bag that fits the 56cm x 40cm x 25cm template.",
          "status": "official",
          "source_url": "https://airsaintpierre.com/travel-informations/luggage",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "carryon_weight": {
          "value": "The carry-on must not exceed 5 kilos.",
          "status": "official",
          "source_url": "https://airsaintpierre.com/travel-informations/luggage",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "personal_item": {
          "value": "One personal item (for example a purse or computer bag) is allowed in addition to the carry-on.",
          "status": "official",
          "source_url": "https://airsaintpierre.com/travel-informations/luggage",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        }
      }
    },
    {
      "id": "baggage",
      "title": "Checked baggage",
      "lede": "Luggage over the allowance is accepted subject to space, with a charge per kilo and per additional bag that depends on the route.",
      "required": [
        "allowance"
      ],
      "fields": {
        "allowance": {
          "value": "One checked bag of 23 kg per person on all international flights to and from Canada and on direct flights to and from Paris, including connections onto Air France in Montreal (30 kilos for Air France Business or Premium passengers).",
          "status": "official",
          "source_url": "https://airsaintpierre.com/travel-informations/luggage",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "magdalen_islands": {
          "value": "To and from the Magdalen Islands (Cessna F406): the 23kg allowance must be split into two smaller bags; 50€ per additional bag.",
          "status": "official",
          "source_url": "https://airsaintpierre.com/travel-informations/luggage",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "infant": {
          "value": "Infants under 2 travelling on a parent's lap: 10 Kg allowance (and/or a small additional bag).",
          "status": "official",
          "source_url": "https://airsaintpierre.com/travel-informations/luggage",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        },
        "excess_fees": {
          "value": "Excess charges, 32kg per bag maximum: St. John's (YYT) 1.63€ per kilo and 50€ per additional bag; Halifax (YHZ) 2.84€ per kilo and 50€ per additional bag; Montreal (YUL) 4.08€ per kilo and 100€ per additional bag; Paris 6.05€ per kilo and 200€ per additional bag.",
          "status": "official",
          "source_url": "https://airsaintpierre.com/travel-informations/luggage",
          "verified_at": "2026-09-04",
          "verified_by": "manual_official_source"
        }
      }
    },
